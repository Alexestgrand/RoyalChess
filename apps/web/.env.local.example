# Copier vers apps/web/.env.local :
#   cp apps/web/.env.local.example apps/web/.env.local
#
# INTERNAL_AUTH_BRIDGE_SECRET doit être strictement identique à celui de apps/api/.env
# (sinon le refresh JWT NextAuth ne fonctionne pas après ~15 min).
# Génération : node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"

NODE_ENV=development
API_URL=http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_SOCKET_URL=http://localhost:3001
NEXTAUTH_SECRET=change-me-nextauth-secret-min-32-chars
NEXTAUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true
INTERNAL_AUTH_BRIDGE_SECRET=change-me-internal-auth-bridge-secret-min-16-characters-long

# Google OAuth (optionnel) — même paire id/secret que côté API si tu actives Google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
