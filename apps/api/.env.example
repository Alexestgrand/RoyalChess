# Copier vers apps/api/.env :
#   cp apps/api/.env.example apps/api/.env
# Ne jamais committer apps/api/.env (secrets).

NODE_ENV=development
API_PORT=3001
DATABASE_URL=postgresql://royalchess:royalchess@localhost:5432/royalchess?schema=public
REDIS_URL=redis://localhost:6379
JWT_ACCESS_SECRET=change-me-access-secret-min-32-characters-long
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-characters-long
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d
# Cookie refresh HTTP-only (défaut royal_refresh si omis)
REFRESH_COOKIE_NAME=royal_refresh
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3001/auth/google/callback
CORS_ORIGIN=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# URL publique de l’API (avatars servis sous /uploads/avatars/…). Doit être
# joignable depuis le navigateur (Next `next/image` si utilisé).
API_PUBLIC_URL=http://localhost:3001

# Répertoire persistant pour les avatars (relatif au cwd de l’API si non absolu).
AVATAR_UPLOAD_DIR=uploads/avatars

# Bridge interne Next ↔ API : doit correspondre à apps/web/.env.local.
# Indispensable pour que le refresh JWT fonctionne (sans lui, refreshToken
# n'est pas renvoyé dans le body et la session NextAuth ne peut pas le stocker).
# Génération : node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
INTERNAL_AUTH_BRIDGE_SECRET=change-me-internal-auth-bridge-secret-min-16-characters-long

# Optionnel — prod derrière reverse-proxy TLS
# BEHIND_TLS_PROXY=1

# Optionnel — grâce déconnexion WebSocket (ms), défaut côté code si absent
# DISCONNECT_GRACE_MS=120000
