# --- Général ---
NODE_ENV=development

# --- Base & cache (docker-compose + API) ---
DATABASE_URL=postgresql://royalchess:royalchess@localhost:5432/royalchess?schema=public
REDIS_URL=redis://localhost:6379
POSTGRES_USER=royalchess
POSTGRES_PASSWORD=royalchess
POSTGRES_DB=royalchess
POSTGRES_PORT=5432
REDIS_PORT=6379

# --- API (apps/api/.env) ---
JWT_ACCESS_SECRET=change-me-access-secret-min-32-characters-long
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-characters-long
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3001/auth/google/callback
CORS_ORIGIN=http://localhost:3000
API_PORT=3001

# --- Next.js / NextAuth (apps/web/.env.local) ---
API_URL=http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_SOCKET_URL=http://localhost:3001
NEXTAUTH_SECRET=change-me-nextauth-secret-min-32-chars
NEXTAUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true

# Exemple à mettre dans apps/api/.env
FRONTEND_URL=http://localhost:3000

# --- Bridge interne Next ↔ API (OBLIGATOIRE pour le refresh JWT) ---
# Doit être présent dans apps/api/.env ET apps/web/.env.local avec la même valeur.
# Sans ce secret, l'API n'envoie pas le refresh token dans le body /auth/login,
# le callback NextAuth ne peut pas rafraîchir le JWT et toutes les routes API
# renvoient 401 après l'expiration de l'access token (15 min par défaut).
# Génération recommandée : node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
INTERNAL_AUTH_BRIDGE_SECRET=change-me-internal-auth-bridge-secret-min-16-characters-long

